# Port the Express server listens on (Render sets this automatically in production)
PORT=4000

# PIN required to access the admin panel - change this!
ADMIN_PIN=1234

# How often (ms) the server refreshes from the Google Sheet in the background. Default: 300000 (5 min)
SYNC_INTERVAL_MS=300000

# The "Web app" URL you get after deploying apps-script/Code.gs from your Google
# Sheet (Extensions > Apps Script > Deploy > New deployment > Web app).
# Looks like: https://script.google.com/macros/s/AKfycb.../exec
APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbw0y9qZUbBt3wrCCX1JiezxExUm4ai0j5M3RsDoMOXcDm5LJErQ1VCpAf3d4vHE5rBpRg/exec

# Must match the SECRET constant you set inside apps-script/Code.gs.
APPS_SCRIPT_SECRET=iposecretkey
